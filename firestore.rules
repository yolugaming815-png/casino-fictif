rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.balance is number;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if request.auth != null
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && (
          (
            resource.data.toUid == request.auth.uid
            && request.resource.data.status in ["accepted", "rejected"]
          )
          || (
            resource.data.fromUid == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "pending"
          )
        );
    }

    match /onlineRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.type in ["duel", "poker"]
        && request.resource.data.status == "waiting"
        && request.resource.data.players is list
        && request.resource.data.maxPlayers is number
        && request.resource.data.duelScores is map;
      allow update: if request.auth != null
        && request.resource.data.type == resource.data.type
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.status in ["waiting", "playing", "finished"]
        && request.resource.data.players is list
        && request.resource.data.players.size() <= resource.data.maxPlayers
        && request.resource.data.duelScores is map;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled != false;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.command is string
        && request.resource.data.message is string;
    }

    match /players/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.displayName is string
          && request.resource.data.balance is number
        );
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if request.auth != null
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && (
          (
            resource.data.toUid == request.auth.uid
            && request.resource.data.status in ["accepted", "rejected"]
          )
          || (
            resource.data.fromUid == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "pending"
          )
        );
    }

    match /skinTrades/{tradeId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.offeredItemId is string
        && request.resource.data.requestedItemId is string
        && request.resource.data.reservedItemId == request.resource.data.offeredItemId
        && request.resource.data.offeredCredits is number
        && request.resource.data.offeredCredits >= 0
        && request.resource.data.requestedCredits is number
        && request.resource.data.requestedCredits >= 0
        && (request.resource.data.offeredItemId != "" || request.resource.data.offeredCredits > 0)
        && (request.resource.data.requestedItemId != "" || request.resource.data.requestedCredits > 0)
        && request.resource.data.status == "pending"
        && request.resource.data.appliedFromUid == false
        && request.resource.data.appliedToUid == false;
      allow update: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.offeredItemId == resource.data.offeredItemId
        && request.resource.data.requestedItemId == resource.data.requestedItemId
        && request.resource.data.status in ["pending", "accepted", "rejected", "canceled"]
        && request.resource.data.appliedFromUid is bool
        && request.resource.data.appliedToUid is bool
        && (
          (
            resource.data.status == "pending"
            && resource.data.toUid == request.auth.uid
            && request.resource.data.status in ["accepted", "rejected"]
            && request.resource.data.appliedFromUid == resource.data.appliedFromUid
            && request.resource.data.appliedToUid == resource.data.appliedToUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt", "updatedAt"])
          )
          || (
            resource.data.status == "pending"
            && resource.data.fromUid == request.auth.uid
            && request.resource.data.status == "canceled"
            && request.resource.data.appliedFromUid == resource.data.appliedFromUid
            && request.resource.data.appliedToUid == resource.data.appliedToUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt", "updatedAt"])
          )
          || (
            resource.data.status in ["accepted", "rejected", "canceled"]
            && request.resource.data.status == resource.data.status
            && (
              (
                resource.data.fromUid == request.auth.uid
                && resource.data.appliedFromUid == false
                && request.resource.data.appliedFromUid == true
                && request.resource.data.appliedToUid == resource.data.appliedToUid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["appliedFromUid", "updatedAt"])
              )
              || (
                resource.data.toUid == request.auth.uid
                && resource.data.appliedToUid == false
                && request.resource.data.appliedToUid == true
                && request.resource.data.appliedFromUid == resource.data.appliedFromUid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["appliedToUid", "updatedAt"])
              )
            )
          )
        );
    }

    match /privateMessages/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && (
          exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid + "_" + request.resource.data.toUid))
          && get(/databases/$(database)/documents/friendRequests/$(request.auth.uid + "_" + request.resource.data.toUid)).data.status == "accepted"
          || exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + "_" + request.auth.uid))
          && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + "_" + request.auth.uid)).data.status == "accepted"
        )
        && request.resource.data.conversationId is string
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.toUid in request.resource.data.participants
        && request.resource.data.fromDisplayName is string
        && request.resource.data.toDisplayName is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 280
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() == 1
        && request.auth.uid in request.resource.data.readBy;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
        && request.resource.data.readBy is list
        && request.auth.uid in request.resource.data.readBy;
    }

    match /onlineRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.type in ["duel", "poker", "russian-roulette", "crash", "roulette-table", "coinflip"]
        && request.resource.data.status == "waiting"
        && request.resource.data.players is list
        && request.resource.data.playerIds is list
        && request.resource.data.maxPlayers is number
        && request.resource.data.duelScores is map
        && request.resource.data.pokerHands is map
        && request.resource.data.communityCards is list
        && request.resource.data.foldedPlayerIds is list
        && request.resource.data.pokerActions is map
        && request.resource.data.pokerPot is number
        && request.resource.data.pokerCurrentBet is number
        && request.resource.data.pokerContributions is map
        && request.resource.data.pokerPaidByPlayer is map
        && request.resource.data.pokerHandId is number
        && request.resource.data.pokerWinnerUids is list
        && request.resource.data.pokerWinnerNames is list
        && request.resource.data.pokerWinnerHandLabel is string
        && request.resource.data.pokerWinnerHandCards is list
        && request.resource.data.pokerShowdownResults is list
        && request.resource.data.russianBet is number
        && request.resource.data.russianPot is number
        && request.resource.data.russianRound is number
        && request.resource.data.russianAliveUids is list
        && request.resource.data.russianEliminatedUids is list
        && request.resource.data.russianPaidRound is map
        && request.resource.data.russianShots is list
        && request.resource.data.russianTurnUid is string
        && request.resource.data.russianTurnName is string;
      // ATTENTION : Firestore limite chaque evaluation de regle a 1000 expressions.
      // L'ancienne version validait le type de ~55 champs un par un (hasAny + is + == null)
      // et depassait cette limite sur les documents room complets : TOUTES les updates
      // etaient refusees ("maximum of 1000 expressions") et aucun jeu multijoueur ne
      // fonctionnait. On garde donc uniquement les invariants de securite essentiels ;
      // ne pas reintroduire de validation champ par champ ici.
      allow update: if request.auth != null
        && (
          isAdmin()
          || (
            request.resource.data.type == resource.data.type
            && request.resource.data.hostUid == resource.data.hostUid
            && (
              request.auth.uid == resource.data.hostUid
              || request.auth.uid in resource.data.playerIds
              || request.auth.uid in request.resource.data.playerIds
            )
            && request.resource.data.status in ["waiting", "playing", "finished"]
            && request.resource.data.players is list
            && request.resource.data.playerIds is list
            && request.resource.data.maxPlayers is number
            && request.resource.data.players.size() <= request.resource.data.maxPlayers
          )
          || (
            (resource.data.type == "russian-roulette" || resource.data.onlineMode == "russian-roulette")
            && resource.data.status == "playing"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["russianSideBets", "updatedAt"])
            && request.resource.data.russianSideBets is map
            && request.resource.data.russianSideBets.diff(resource.data.get("russianSideBets", {})).affectedKeys().hasOnly([request.auth.uid])
          )
        );
      allow delete: if request.auth != null
        && (isAdmin() || (
          (
            resource.data.status == "waiting"
            && request.time > resource.data.createdAt + duration.value(30, "m")
          )
          || (
            resource.data.type == "poker"
            && resource.data.status == "playing"
            && request.auth.uid in resource.data.playerIds
            && request.time > resource.data.updatedAt + duration.value(30, "m")
          )
          || (
            resource.data.type == "poker"
            && resource.data.status == "finished"
            && request.auth.uid in resource.data.playerIds
          )
          || (
            resource.data.type == "russian-roulette"
            && resource.data.status == "finished"
            && request.auth.uid in resource.data.playerIds
            && request.time > resource.data.updatedAt + duration.value(1, "m")
          )
          || (
            resource.data.type in ["crash", "roulette-table"]
            && resource.data.status == "playing"
            && request.auth.uid in resource.data.playerIds
            && request.time > resource.data.updatedAt + duration.value(30, "m")
          )
          || (
            resource.data.type == "coinflip"
            && resource.data.status == "finished"
            && request.auth.uid in resource.data.playerIds
            && request.time > resource.data.updatedAt + duration.value(1, "m")
          )
        ));
    }

    match /gifts/{giftId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount >= 1
        && request.resource.data.amount <= 10000
        && request.resource.data.kind in ["gift", "rain"]
        && request.resource.data.status == "pending"
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 140
        && request.resource.data.dayKey is string;
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.status == "claimed"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "claimedAt"]);
    }

    match /friendBets/{betId} {
      allow read: if request.auth != null
        && (isAdmin() || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.opponentUid is string
        && request.resource.data.opponentUid != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.creatorUid in request.resource.data.participants
        && request.resource.data.opponentUid in request.resource.data.participants
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.stake is int
        && request.resource.data.stake >= 25
        && request.resource.data.stake <= 100000
        && request.resource.data.status == "proposed";
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.opponentUid == resource.data.opponentUid
        && request.resource.data.stake == resource.data.stake
        && request.resource.data.title == resource.data.title
        && request.resource.data.status in ["proposed", "declined", "active", "resolved", "canceled"]
        && (
          !request.resource.data.keys().hasAny(["winnerUid"])
          || request.resource.data.winnerUid == ""
          || request.resource.data.winnerUid in resource.data.participants
        )
        && (
          (
            resource.data.opponentUid == request.auth.uid
            && resource.data.status == "proposed"
            && request.resource.data.status in ["active", "declined"]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedAt", "updatedAt"])
          )
          || (
            resource.data.creatorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "creatorEscrowed",
              "creatorDeclaredUid",
              "creatorCancelVote",
              "creatorRefunded",
              "payoutClaimed",
              "status",
              "winnerUid",
              "resolvedAt",
              "updatedAt"
            ])
          )
          || (
            resource.data.opponentUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "opponentEscrowed",
              "opponentDeclaredUid",
              "opponentCancelVote",
              "opponentRefunded",
              "payoutClaimed",
              "status",
              "winnerUid",
              "resolvedAt",
              "updatedAt"
            ])
          )
        );
    }

    match /feedReactions/{reactionId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.reactions is map
        && request.resource.data.reactions.keys().hasOnly(["clap", "laugh", "fire"]);
    }

    match /globalState/{stateId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (
          isAdmin()
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pot", "updatedAt"])
            && request.resource.data.pot is number
            && request.resource.data.pot > resource.data.pot
            && request.resource.data.pot <= resource.data.pot + 1000
          )
          || (
            request.resource.data.pot == 2000
            && resource.data.pot > 0
            && request.resource.data.lastWinnerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pot", "lastWinnerUid", "lastWinnerName", "lastWonAt", "updatedAt"])
          )
        );
    }

    match /activityEvents/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ["big-win", "jackpot", "legendary-drop", "bankrupt", "soup", "level-up", "season-champion", "weekly-champion"]
        && request.resource.data.displayName is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 200;
      allow update: if false;
      allow delete: if request.auth != null
        && (
          isAdmin()
          || resource.data.uid == request.auth.uid
          || request.time > resource.data.createdAt + duration.value(3, 'd')
        );
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.top is list
        && request.resource.data.top.size() <= 3;
      allow update, delete: if isAdmin();
    }

    match /weeks/{weekId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.top is list
        && request.resource.data.top.size() <= 3;
      allow update, delete: if isAdmin();
    }
  }
}
